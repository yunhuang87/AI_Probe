# JoyAgent Adapter Service Environment Configuration

# Service Configuration
JOYAGENT_ADAPTER_SERVICE_NAME=joyagent-adapter
JOYAGENT_ADAPTER_SERVICE_HOST=0.0.0.0
JOYAGENT_ADAPTER_SERVICE_PORT=8007
JOYAGENT_ADAPTER_DEBUG=false
JOYAGENT_ADAPTER_LOG_LEVEL=info

# JoyAgent-JDGenie Configuration
JOYAGENT_ADAPTER_JOYAGENT_HOST=localhost
JOYAGENT_ADAPTER_JOYAGENT_PORT=8080
JOYAGENT_ADAPTER_JOYAGENT_UI_PORT=3000
JOYAGENT_ADAPTER_JOYAGENT_CLIENT_PORT=1601
JOYAGENT_ADAPTER_JOYAGENT_API_TIMEOUT=300

# Whether to start the JoyAgent frontend UI (for development/demo)
JOYAGENT_START_FRONTEND=false

# Database Configuration
JOYAGENT_ADAPTER_DB_HOST=postgres
JOYAGENT_ADAPTER_DB_PORT=5432
JOYAGENT_ADAPTER_DB_USER=postgres
JOYAGENT_ADAPTER_DB_PASSWORD=postgres
JOYAGENT_ADAPTER_DB_NAME=enterprise_ai_platform

# Redis Configuration
JOYAGENT_ADAPTER_REDIS_HOST=redis
JOYAGENT_ADAPTER_REDIS_PORT=6379
JOYAGENT_ADAPTER_REDIS_DB=0

# Platform Integration URLs
JOYAGENT_ADAPTER_MCP_GATEWAY_URL=http://mcp-gateway:8001
JOYAGENT_ADAPTER_WORKFLOW_ENGINE_URL=http://workflow-engine:8002
JOYAGENT_ADAPTER_AUTH_SERVICE_URL=http://auth-service:8003
JOYAGENT_ADAPTER_KNOWLEDGE_BASE_URL=http://knowledge-base:8004
JOYAGENT_ADAPTER_METADATA_SERVICE_URL=http://metadata-service:8005
JOYAGENT_ADAPTER_API_GATEWAY_URL=http://api-gateway:8080

# AI Configuration
JOYAGENT_ADAPTER_LLM_MODEL=deepseek-chat
JOYAGENT_ADAPTER_LLM_BASE_URL=https://api.deepseek.com
JOYAGENT_ADAPTER_OPENAI_API_KEY=your-api-key-here

# Task Configuration
JOYAGENT_ADAPTER_MAX_CONCURRENT_TASKS=10
JOYAGENT_ADAPTER_TASK_TIMEOUT=600
JOYAGENT_ADAPTER_TASK_RETRY_COUNT=3
JOYAGENT_ADAPTER_TASK_RETRY_DELAY=5

# Context Management
JOYAGENT_ADAPTER_CONTEXT_MAX_SIZE=100
JOYAGENT_ADAPTER_CONTEXT_TTL=3600

# Security
JOYAGENT_ADAPTER_JWT_SECRET_KEY=your-jwt-secret-key
JOYAGENT_ADAPTER_JWT_ALGORITHM=HS256
JOYAGENT_ADAPTER_JWT_EXPIRE_MINUTES=30

# Performance
JOYAGENT_ADAPTER_WORKER_PROCESSES=1
JOYAGENT_ADAPTER_MAX_REQUEST_SIZE=104857600

# Monitoring
JOYAGENT_ADAPTER_ENABLE_METRICS=true
JOYAGENT_ADAPTER_METRICS_PORT=9090