# Project env example - copy to .env and edit. Must be UTF-8 (no BOM).
# Python
PYTHON_VERSION=3.11
# Node
NODE_VERSION=20

DEBUG=true
LOG_LEVEL=info

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=ai_user
DB_PASSWORD=ai_password
DB_NAME=ai_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MCP / Workflow / Web / Auth / Knowledge Base
MCP_GATEWAY_PORT=8001
WORKFLOW_ENGINE_PORT=8002
WEB_UI_PORT=3000
AUTH_SERVICE_PORT=8003
KNOWLEDGE_BASE_PORT=8004
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
DOCUMENT_STORAGE_DIR=./documents
MAX_FILE_SIZE=104857600
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# AI (OpenAI/DeepSeek etc.)
OPENAI_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false

# Frontend public URLs (browser)
NEXT_PUBLIC_MCP_GATEWAY_URL=http://localhost:8001
NEXT_PUBLIC_WORKFLOW_ENGINE_URL=http://localhost:8002
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_KNOWLEDGE_BASE_URL=http://localhost:8004
# OpenCode 独立地址（与 19 服务无关，仅用于登录认证后跳转）
# 建议使用门户代理：/opencode-proxy（避免直接暴露 4096）
# NEXT_PUBLIC_OPENCODE_URL=/opencode-proxy
# 也可使用独立地址（需对外可访问）：
# NEXT_PUBLIC_OPENCODE_URL=https://opencode.example.com

# Service URLs (container network)
WORKFLOW_ENGINE_URL=http://workflow-engine:8002
MCP_GATEWAY_URL=http://mcp-gateway:8001
AUTH_SERVICE_URL=http://auth-service:8003
KNOWLEDGE_BASE_URL=http://knowledge-base:8004

# OpenCode 同机服务（可选，见 docs/deployment/OpenCode同机部署实施方案.md）
OPENCODE_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Deployment Agent（可选）
DEPLOYMENT_AGENT_PORT=8007

COMPOSE_PROJECT_NAME=enterprise-ai-platform
