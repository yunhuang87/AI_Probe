# OpenCode 环境变量 - 复制为 .env 后按需修改
# 必填：工作目录（与 19 服务同机时填项目根目录，供 /workspace 挂载）
OPENCODE_WORKSPACE=/opt/enterprise-ai-platform

# 必填（与 19 服务同机时）：主 compose 创建的网络名通常带前缀，先执行 docker network ls 查看
# 例如: enterprise-ai-platform_enterprise-ai-network 或 intl-tst-mcp_enterprise-ai-network
EXTERNAL_NETWORK_NAME=enterprise-ai-platform_enterprise-ai-network

# 可选
OPENCODE_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=12345678

